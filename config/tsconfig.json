{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "rootDir": "./",
        "jsx": "react",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "noEmit": true,
        "isolatedModules": true
    },
    "include": ["js/**/*", "pages/**/*"],
    "exclude": ["node_modules", "dist"]
}
